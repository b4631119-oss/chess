{
  "name": "@chess/web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "assets": "node scripts/copy-stockfish.mjs",
    "dev": "node scripts/copy-stockfish.mjs && vite",
    "build": "node scripts/copy-stockfish.mjs && tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/copy-stockfish.mjs && playwright test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@chess/chess-core": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "stockfish": "^19.0.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
